SILO_DATA_DIR=./data
SILO_HOST=0.0.0.0
SILO_PORT=8001
SILO_TIMEZONE=Asia/Shanghai

# OpenAI-compatible LLM endpoint (e.g. llama-server, vLLM, Ollama, etc.)
SILO_LLM_BASE_URL=http://127.0.0.1:18080/v1
SILO_LLM_MODEL=qwen3.8-27b-q8_0
SILO_LLM_API_KEY=
SILO_LLM_TIMEOUT_SECONDS=600

# OpenAI-compatible or FunASR ASR endpoint
SILO_ASR_BASE_URL=http://127.0.0.1:8000
SILO_ASR_API_KEY=
SILO_ASR_TIMEOUT_SECONDS=7200
SILO_ASR_LANGUAGE=zh
SILO_TRANSCRIPTION_WORKERS=4

# Temporary media is removed after a successful transcript by default.
SILO_KEEP_MEDIA=false
SILO_MAX_WORKERS=1
PLAYWRIGHT_BROWSERS_PATH=./data/browsers

# Optional shared token. Leave blank when access is restricted by private network.
SILO_ADMIN_TOKEN=

